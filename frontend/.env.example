# Backend usado pelo proxy do Vite em desenvolvimento (npm run dev).
# Padrão: https://proexpense-backend.onrender.com — use http://localhost:8090 para o backend local.
VITE_BACKEND_URL=https://proexpense-backend.onrender.com

# Base da API no build de produção. Se omitida, chama /api/v1 na mesma origem; na Vercel o
# rewrite de vercel.json repassa ao Render. Defina uma URL só se esse backend liberar CORS.
# VITE_API_BASE_URL=https://proexpense-backend.onrender.com
